/* pages/profile/profile.wxss */
.container {
  padding: 0 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
  margin-bottom: 60rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

.profile-container {
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title:before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background-color: #7B55D0;
  border-radius: 4rpx;
}

.avatar-section, 
.nickname-section {
  margin-bottom: 50rpx;
}

.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx 0;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
  padding: 0;
  border: none;
  background-color: transparent;
  overflow: hidden;
  position: relative;
}

.avatar-btn::after {
  border: none;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  border: 4rpx solid rgba(123, 85, 208, 0.2);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
}

.avatar-tip, 
.nickname-tip {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  margin-top: 16rpx;
}

.nickname-wrapper {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.nickname-input {
  height: 90rpx;
  border-bottom: 1rpx solid #e0e0e0;
  font-size: 32rpx;
  color: #333;
  width: 100%;
  text-align: center;
  padding: 10rpx 0;
}

.action-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 60rpx;
}

.cancel-btn, 
.save-btn {
  width: 45%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  text-align: center;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
  border: 1rpx solid #e0e0e0;
}

.save-btn {
  background-color: #7B55D0;
  color: #fff;
} 