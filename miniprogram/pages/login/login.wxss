/* pages/login/login.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 30rpx;
  background-color: #fff;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
  margin-bottom: 100rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 40rpx;
}

.logo-container {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.logo-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8a63d2, #6c45c4);
  box-shadow: 0 8rpx 20rpx rgba(123, 85, 208, 0.3);
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.logo-placeholder::after {
  content: "话术";
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

.login-container {
  width: 100%;
}

.login-tip {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
}

/* 授权复选框样式 */
.auth-agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  border-color: #7B55D0;
  background-color: #7B55D0;
}

.checkbox-inner {
  width: 20rpx;
  height: 20rpx;
  background-color: white;
  border-radius: 2rpx;
}

.agreement-text {
  font-size: 28rpx;
  color: #333;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #7B55D0;
  color: #fff;
  border-radius: 10rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.login-btn.disabled {
  background-color: #cccccc;
  color: #999999;
}

.auth-tip {
  font-size: 24rpx;
  color: #ff5252;
  text-align: center;
  margin-bottom: 30rpx;
}

.privacy-policy {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.link {
  color: #7B55D0;
}