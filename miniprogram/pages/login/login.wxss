/* pages/login/login.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 30rpx;
  background-color: #fff;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
  margin-bottom: 60rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 40rpx;
}

.logo-container {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.logo-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8a63d2, #6c45c4);
  box-shadow: 0 8rpx 20rpx rgba(123, 85, 208, 0.3);
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.logo-placeholder::after {
  content: "话术";
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

.login-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 已注册用户简化登录样式 */
.simple-login {
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-large {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 30rpx;
  border: 4rpx solid rgba(123, 85, 208, 0.2);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
}

.welcome-back {
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

/* 登录步骤提示 */
.login-steps {
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.step {
  font-size: 24rpx;
  color: #999;
  position: relative;
  padding-bottom: 16rpx;
}

.step.active {
  color: #7B55D0;
  font-weight: bold;
}

.step.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background-color: #7B55D0;
  border-radius: 2rpx;
}

/* 用户信息区域 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
  width: 100%;
}

.avatar-tip {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  text-align: center;
}

.avatar-wrapper {
  background-color: transparent;
  padding: 0;
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: none;
  position: relative;
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
}

.avatar-edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: #7B55D0;
  color: white;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
}

.nickname-wrapper {
  width: 80%;
  margin-top: 10rpx;
}

.nickname-tip {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  text-align: center;
}

.nickname-input {
  height: 80rpx;
  border-bottom: 1rpx solid #e0e0e0;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}

.login-tip {
  font-size: 28rpx;
  color: #7B55D0;
  text-align: center;
  margin-bottom: 30rpx;
  font-weight: bold;
}

/* 添加协议勾选样式 */
.auth-agreement, .privacy-agreement {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  width: 90%;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #7B55D0;
  border-radius: 6rpx;
  margin-right: 16rpx;
  position: relative;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: #7B55D0;
}

.checkbox-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform-origin: center;
  transform: translate(-50%, -70%) rotate(-45deg);
}

.agreement-text {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  line-height: 1.4;
}

.link {
  color: #7B55D0;
  display: inline;
}

/* 登录按钮样式 */
.btn-container {
  width: 80%;
  margin-top: 40rpx;
  margin-bottom: 30rpx;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #8a63d2, #6c45c4);
  color: white;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 6rpx 20rpx rgba(123, 85, 208, 0.3);
}

.login-btn.disabled {
  background: linear-gradient(135deg, #b5a6d2, #a48dc4);
  box-shadow: none;
  color: rgba(255, 255, 255, 0.8);
}

/* 授权提示样式 */
.login-tip, .auth-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 删除原有的privacy-policy样式，使用privacy-agreement替代 */