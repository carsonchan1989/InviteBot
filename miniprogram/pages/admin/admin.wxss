/* pages/admin/admin.wxss */
.container {
  padding: 0;
  background-color: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 120rpx; /* 为tabBar预留空间 */
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  background: linear-gradient(135deg, #8a63d2, #6c45c4);
  padding: 60rpx 30rpx;
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(123, 85, 208, 0.3);
  margin: 30rpx 30rpx 0;
  border-radius: 20rpx;
  width: calc(100% - 60rpx);
  box-sizing: border-box;
}

.avatar-container {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-wrapper {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
  transition: transform 0.3s;
}

.avatar-wrapper:active {
  transform: scale(0.95);
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
}

.avatar-edit-icon {
  display: none; /* 隐藏编辑图标 */
}

/* 注释掉加号样式 
.edit-icon::before,
.edit-icon::after {
  content: '';
  position: absolute;
  background-color: #fff;
}

.edit-icon::before {
  width: 12rpx;
  height: 2rpx;
  top: 9rpx;
  left: 4rpx;
}

.edit-icon::after {
  width: 2rpx;
  height: 12rpx;
  top: 4rpx;
  left: 9rpx;
}
*/

.avatar-placeholder {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.9);
  margin-right: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.2);
  position: relative;
  transition: transform 0.3s;
}

.avatar-placeholder:active {
  transform: scale(0.95);
}

.avatar-placeholder::after {
  content: "";
  position: absolute;
  top: 25%;
  left: 50%;
  transform: translateX(-50%);
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  background-color: rgba(123, 85, 208, 0.4);
}

.avatar-placeholder::before {
  content: "";
  position: absolute;
  bottom: 20%;
  left: 50%;
  transform: translateX(-50%);
  width: 75rpx;
  height: 38rpx;
  border-radius: 35rpx 35rpx 0 0;
  background-color: rgba(123, 85, 208, 0.4);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}

.usage-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: rgba(255, 255, 255, 0.25);
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  max-width: 100%;
  box-sizing: border-box;
  flex-wrap: nowrap;
  align-self: flex-start;
}

.usage {
  font-size: 26rpx;
  opacity: 0.95;
  white-space: nowrap;
}

.section {
  margin: 30rpx 30rpx 0;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
  width: calc(100% - 60rpx);
  box-sizing: border-box;
}

.section:last-of-type {
  margin-bottom: 30rpx;
}

.section:active {
  transform: scale(0.99);
}

.section-title {
  font-size: 32rpx;
  color: #555;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid #f0f0f0;
  font-weight: 600;
  display: flex;
  align-items: center;
  background-color: #fcfcfc;
  width: 100%;
  box-sizing: border-box;
}

.title-text {
  position: relative;
  padding-left: 22rpx;
  letter-spacing: 1px;
  display: block;
  line-height: 44rpx;
}

.title-text::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background-color: #7B55D0;
  border-radius: 4rpx;
}

/* 统一所有紫色标题条 */
.section-title .title-text {
  width: 100%;
  box-sizing: border-box;
}

/* 统一菜单项图标容器 */
[class^="icon-"] {
  width: 40rpx;
  height: 40rpx;
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
}

/* 统一箭头样式 */
.menu-item__arrow {
  font-size: 32rpx;
  color: #bbb;
  margin-left: 20rpx;
  font-family: "Arial";
  flex-shrink: 0;
  width: 20rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
}

.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1px solid #f5f5f5;
  transition: background-color 0.2s;
  width: 100%;
  box-sizing: border-box;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f9f9f9;
}

.menu-item__left {
  display: flex;
  align-items: center;
  min-width: 220rpx;
  width: 75%;
}

.menu-item__left [class^="icon-"] {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  opacity: 0.8;
  flex-shrink: 0;
}

.menu-item__label {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.menu-item__value {
  font-size: 30rpx;
  color: #888;
  margin-left: auto;
}

/* 确保注册时间在手机端不会分行显示 */
.time-value {
  min-width: 180rpx;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.logout {
  color: #e64340;
  font-weight: 500;
}

.footer {
  text-align: center;
  padding: 0 0 80rpx;
  margin: 30rpx 30rpx 0;
  width: calc(100% - 60rpx);
  box-sizing: border-box;
}

.footer-text {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 1px;
  display: block;
  line-height: 40rpx;
  padding: 20rpx 0;
}

.refresh-btn {
  color: #fff;
  font-size: 22rpx;
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  white-space: nowrap;
  min-width: 44rpx;
}

