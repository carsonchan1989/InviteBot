/* pages/admin/admin.wxss */
.container {
  padding: 0;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #8a63d2, #6c45c4);
  padding: 50rpx 30rpx;
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(123, 85, 208, 0.3);
}

.avatar-container {
  display: flex;
  align-items: center;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: #fff;
  margin-right: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.8);
  margin-right: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.avatar-placeholder::after {
  content: "";
  position: absolute;
  top: 25%;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: rgba(123, 85, 208, 0.3);
}

.avatar-placeholder::before {
  content: "";
  position: absolute;
  bottom: 20%;
  left: 50%;
  transform: translateX(-50%);
  width: 70rpx;
  height: 35rpx;
  border-radius: 35rpx 35rpx 0 0;
  background-color: rgba(123, 85, 208, 0.3);
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.usage {
  font-size: 30rpx;
  opacity: 0.9;
  background-color: rgba(255, 255, 255, 0.2);
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
}

.section {
  margin: 30rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  color: #666;
  padding: 24rpx 30rpx;
  border-bottom: 1px solid #f0f0f0;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.title-text {
  position: relative;
  padding-left: 18rpx;
}

.title-text::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  background-color: #7B55D0;
  border-radius: 4rpx;
}

.menu-list {
  padding: 0 30rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1px solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item__left {
  display: flex;
  align-items: center;
}

.menu-item__label {
  font-size: 32rpx;
  color: #333;
}

.menu-item__value {
  font-size: 30rpx;
  color: #888;
}

.menu-item__arrow {
  font-size: 30rpx;
  color: #bbb;
  margin-left: 10rpx;
}

.logout {
  color: #e64340;
  font-weight: 500;
}

/* 添加点击效果 */
.menu-item:active {
  background-color: #f9f9f9;
}

.footer {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #999;
} 