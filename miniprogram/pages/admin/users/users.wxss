/* pages/admin/users/users.wxss */
.container {
  padding: 30rpx;
  background-color: #f6f6f6;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 10rpx;
}

/* 搜索和筛选区域 */
.search-filter {
  background-color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.search-box {
  position: relative;
  display: flex;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 15rpx 20rpx;
  font-size: 28rpx;
}

.search-btn {
  padding: 15rpx 30rpx;
  background-color: #07c160;
  color: white;
  margin-left: 15rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.clear-btn {
  position: absolute;
  right: 120rpx;
  top: 15rpx;
  font-size: 32rpx;
  color: #999;
}

.filter-row {
  display: flex;
  margin-top: 20rpx;
}

.filter-item {
  background-color: #f5f5f5;
  padding: 10rpx 20rpx;
  margin-right: 20rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.picker {
  display: flex;
  align-items: center;
}

.arrow {
  font-size: 20rpx;
  margin-left: 10rpx;
  color: #999;
}

/* 用户列表 */
.user-list {
  margin-bottom: 30rpx;
}

.user-item {
  display: flex;
  padding: 30rpx;
  background-color: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

/* 添加用户头像样式 */
.user-avatar {
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f0f0f0;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.default-avatar {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
  background-color: #07c160;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

/* 添加用户ID样式 */
.user-id {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
  margin-left: 10rpx;
}

.user-meta {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.role {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-right: 15rpx;
}

.role.admin {
  background-color: #ff9800;
  color: white;
}

.role.beautician {
  background-color: #2196f3;
  color: white;
}

.create-time {
  color: #999;
}

.user-usage {
  font-size: 26rpx;
  color: #666;
  display: flex;
}

.user-usage text {
  margin-right: 20rpx;
}

.highlight {
  color: #07c160;
  font-weight: bold;
}

.actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.action-btn {
  margin-bottom: 15rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
}

.edit {
  background-color: #2196f3;
  color: white;
}

.add-usage {
  background-color: #ff9800;
  color: white;
}

/* 空数据提示 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 加载动画 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #999;
  font-size: 28rpx;
}

/* 分页提示 */
.pagination-tip {
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 26rpx;
} 