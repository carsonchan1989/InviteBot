/* pages/admin/projects/projects.wxss */
.container {
  padding: 30rpx;
  background-color: #f6f6f6;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 分类导航 */
.category-nav {
  margin-bottom: 30rpx;
}

.category-scroll {
  white-space: nowrap;
  width: 100%;
}

.category-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.category-item {
  padding: 15rpx 30rpx;
  margin-right: 20rpx;
  background: white;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  display: inline-flex;
  align-items: center;
}

.category-item.active {
  background: #ff6b81;
  color: white;
}

.category-item.add {
  background: #f0f0f0;
  color: #333;
}

.add-icon {
  font-size: 32rpx;
  margin-right: 6rpx;
  font-weight: bold;
}

/* 项目容器 */
.project-container {
  background: white;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.category-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.category-actions {
  display: flex;
}

.action-btn {
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-left: 15rpx;
}

.action-btn.add-item {
  background: #a0e3ff;
  color: #0081cc;
}

.action-btn.delete-category {
  background: #ffdddd;
  color: #ff4040;
}

/* 项目列表 */
.project-list {
  padding: 10rpx 0;
}

.project-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.project-item:last-child {
  border-bottom: none;
}

.project-name {
  font-size: 30rpx;
  color: #333;
}

.project-actions {
  display: flex;
}

.action-btn.delete-item {
  background: #f5f5f5;
  color: #999;
}

/* 添加输入框 */
.add-input-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.add-input-box {
  width: 80%;
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
}

.add-input-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.add-input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.add-input-actions {
  display: flex;
  justify-content: space-between;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  text-align: center;
  padding: 15rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
  margin-right: 15rpx;
}

.confirm-btn {
  background: #ff6b81;
  color: white;
  margin-left: 15rpx;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 50rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 30rpx 0;
}

.loading-spinner {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #ff6b81;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
} 