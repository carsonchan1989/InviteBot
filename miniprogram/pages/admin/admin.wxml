<view class="container">
  <view class="header">
    <view class="avatar-container">
      <view class="avatar-wrapper" bindtap="navigateToProfile">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view class="avatar-edit-icon">
          <view class="edit-icon"></view>
        </view>
      </view>
      <view class="user-info">
        <view class="nickname">{{nickName || (role === 'admin' ? '管理员' : '美容师')}}</view>
        <view class="usage-container">
          <view class="usage">剩余次数：{{remainingUsage}} 次</view>
          <text class="refresh-btn" bindtap="getUserInfo">刷新</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text class="title-text">个人信息</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="navigateToProfile">
        <view class="menu-item__left">
          <view class="icon-profile"></view>
          <view class="menu-item__label">修改头像昵称</view>
        </view>
        <view class="menu-item__arrow">></view>
      </view>
      <view class="menu-item">
        <view class="menu-item__left">
          <view class="icon-role"></view>
          <view class="menu-item__label">角色</view>
        </view>
        <view class="menu-item__value">{{role === 'admin' ? '管理员' : '美容师'}}</view>
      </view>
      <view class="menu-item">
        <view class="menu-item__left">
          <view class="icon-time"></view>
          <view class="menu-item__label">注册时间</view>
        </view>
        <view class="menu-item__value">{{createTimeFormatted}}</view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{role === 'admin'}}">
    <view class="section-title">
      <text class="title-text">管理功能</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="navigateToUserManage">
        <view class="menu-item__left">
          <view class="icon-users"></view>
          <view class="menu-item__label">用户管理</view>
        </view>
        <view class="menu-item__arrow">></view>
      </view>
      <view class="menu-item" bindtap="navigateToProjectManage">
        <view class="menu-item__left">
          <view class="icon-projects"></view>
          <view class="menu-item__label">项目管理</view>
        </view>
        <view class="menu-item__arrow">></view>
      </view>
      <view class="menu-item" bindtap="navigateToUsageStats">
        <view class="menu-item__left">
          <view class="icon-stats"></view>
          <view class="menu-item__label">使用统计</view>
        </view>
        <view class="menu-item__arrow">></view>
      </view>
      <view class="menu-item" bindtap="navigateToInvitationCodes">
        <view class="menu-item__left">
          <view class="icon-invite"></view>
          <view class="menu-item__label">邀请码管理</view>
        </view>
        <view class="menu-item__arrow">></view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text class="title-text">历史记录</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="navigateToHistory">
        <view class="menu-item__left">
          <view class="icon-history"></view>
          <view class="menu-item__label">生成历史</view>
        </view>
        <view class="menu-item__arrow">></view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text class="title-text">系统</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="contactAdmin" wx:if="{{role !== 'admin'}}">
        <view class="menu-item__left">
          <view class="icon-contact"></view>
          <view class="menu-item__label">联系管理员</view>
        </view>
        <view class="menu-item__arrow">></view>
      </view>
      <view class="menu-item" bindtap="navigateToRedeemCode">
        <view class="menu-item__left">
          <view class="icon-redeem"></view>
          <view class="menu-item__label">兑换邀请码</view>
        </view>
        <view class="menu-item__arrow">></view>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <view class="menu-item__left">
          <view class="icon-about"></view>
          <view class="menu-item__label">关于我们</view>
        </view>
        <view class="menu-item__arrow">></view>
      </view>
      <view class="menu-item" bindtap="logout">
        <view class="menu-item__left">
          <view class="menu-item__label logout">退出登录</view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="footer">
    <text class="footer-text">美容师邀约话术生成器 v1.0</text>
  </view>
</view> 