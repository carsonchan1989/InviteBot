/* pages/index/index.wxss */
.container {
  padding: 30rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.usage {
  font-size: 28rpx;
  color: #7B55D0;
}

.form-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item__label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.form-item__input {
  border: 1px solid #e6e6e6;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
}

.placeholder {
  color: #999;
}

.btn-group {
  margin-top: 50rpx;
  display: flex;
  flex-direction: column;
}

.primary-btn {
  background-color: #7B55D0;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.secondary-btn {
  background-color: #f0f0f0;
  color: #333;
  border-radius: 8rpx;
  font-size: 32rpx;
}

/* 添加必填项标记样式 */
.required {
  color: #e74c3c;
  margin-left: 4px;
} 