/* pages/result/result.wxss */
.container {
  padding: 20rpx;
  background-color: #f6f6f6;
  min-height: 100vh;
  padding-bottom: 180rpx; /* 增加底部padding，为tabbar留出空间 */
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.back-btn {
  font-size: 28rpx;
  color: #fff;
  background-color: #7B55D0;
  padding: 0 24rpx;
  margin: 0;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 8rpx;
}

/* 快照提示样式 */
.snapshot-tip {
  background-color: #e4f2ff;
  color: #1989fa;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 卡片通用样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eaeaea;
}

/* 提示信息样式 */
.tips .card-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.tips-content {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* 脚本卡片样式 */
.scripts-container {
  margin-bottom: 40rpx;
  width: 100%;
}

.script-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
  width: 100%;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

/* 选中状态的脚本卡片样式 */
.script-card.active {
  background-color: #f8f4ff;
  border: 1px solid #7B55D0;
  box-shadow: 0 4rpx 12rpx rgba(123, 85, 208, 0.15);
}

.script-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #7B55D0;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.script-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 16rpx;
  padding-right: 60rpx;
  word-break: break-all;
}

/* 脚本操作按钮区域 */
.script-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 16rpx;
}

.copy-btn {
  background: #7B55D0;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
}

/* 脚本卡片中的分享按钮 */
.share-btn {
  background: #6fb3ec;
  color: #fff;
  font-size: 24rpx;
  padding: 0 16rpx;
  border-radius: 30rpx;
  line-height: 1.8;
  height: auto;
  margin: 0;
}

/* 邀约信息样式 */
.info-item {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
}

.info-item .label {
  flex: 0 0 140rpx;
  color: #666;
  white-space: nowrap;
}

.info-item .value {
  flex: 1;
  color: #333;
  font-weight: 500;
  word-break: break-all;
}

.action-buttons {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 40rpx;
  margin-bottom: 60rpx; /* 增加底部边距 */
  padding: 0 20rpx;
  width: 100%;
  position: relative; /* 确保按钮显示在tabbar上方 */
  z-index: 10; /* 增加z-index确保在tabbar上方 */
}

.primary-btn, .secondary-btn {
  width: 48%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.primary-btn {
  background: #7B55D0;
  color: #fff;
}

.secondary-btn {
  background: #fff;
  color: #7B55D0;
  border: 1rpx solid #7B55D0;
}

/* 底部分享按钮 */
.share-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #6fb3ec;
  color: #fff;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-top: 10rpx;
}

/* 悬浮分享按钮 */
.float-share-container {
  position: fixed;
  right: 30rpx;
  bottom: 180rpx;
  z-index: 100;
}

.float-share-btn {
  background-color: #6fb3ec;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.share-icon {
  font-size: 36rpx;
  color: #fff;
  line-height: 1;
  margin-bottom: 4rpx;
}

.share-text {
  font-size: 24rpx;
  color: #fff;
  line-height: 1;
}

/* 添加空数据提示的样式 */
.empty-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200px;
  width: 100%;
  background-color: #f7f7f7;
  border-radius: 12px;
  margin: 20px 0;
}

.loading-text, .empty-text {
  font-size: 16px;
  color: #666;
  text-align: center;
  margin: 10px 0;
}

.loading-text {
  color: #007aff;
}

/* 添加邀约信息样式 */
.invite-info {
  width: 100%;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 宣传部分 */
.promo-section {
  width: 100%;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.qrcode-container {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.qrcode {
  width: 180rpx;
  height: 180rpx;
  margin-right: 20rpx;
}

.qrcode-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.blue-text {
  color: #1989fa;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.tip-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.slogan-container {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}

.slogan-line {
  display: flex;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.slogan-prefix {
  color: #333;
}

.slogan-highlight {
  color: #ff6767;
  font-weight: bold;
  margin: 0 4rpx;
}

.slogan-suffix {
  color: #333;
}

.slogan-bold {
  color: #1989fa;
  font-weight: bold;
  margin-left: 4rpx;
} 