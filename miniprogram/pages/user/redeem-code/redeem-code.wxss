/* 页面容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f7f7f7;
  box-sizing: border-box;
}

/* 页面头部 */
.header {
  margin-bottom: 40rpx;
  padding: 0 10rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  text-align: center;
}

.usage-info {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

.usage-count {
  color: #7B55D0;
  font-weight: bold;
}

/* 卡片通用样式 */
.redeem-box,
.usage-explain {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  width: calc(100% - 20rpx);
  box-sizing: border-box;
  margin-left: auto;
  margin-right: auto;
}

/* 输入框和按钮的容器 */
.input-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.input-area {
  position: relative;
  flex: 2;
  margin-right: 20rpx;
}

.code-input {
  height: 90rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  color: #333;
  letter-spacing: 2rpx;
  width: 100%;
  box-sizing: border-box;
}

.placeholder {
  color: #ccc;
}

.clear-btn {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #999;
  font-size: 40rpx;
  line-height: 1;
}

.tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.redeem-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #7B55D0;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 10rpx rgba(123, 85, 208, 0.3);
  padding: 0;
  margin: 0;
}

.redeem-btn.disabled {
  background-color: #cccccc;
  box-shadow: none;
}

/* 使用说明 */
.explain-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.explain-item {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.5;
}

/* 结果弹窗 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.result-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.result-content {
  width: 80%;
  background-color: #fff;
  border-radius: 15rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  position: relative;
  z-index: 1001;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin: 0 auto 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
}

.success-icon {
  background-color: #07c160;
  color: #fff;
}

.fail-icon {
  background-color: #ff4d4f;
  color: #fff;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.result-detail {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.result-btn {
  background-color: #7B55D0;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 0;
  margin-top: 30rpx;
  font-size: 30rpx;
} 